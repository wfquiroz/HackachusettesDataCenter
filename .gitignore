# Kiro: the .kiro/ directory MUST be committed (hackathon requirement).
# Only exclude the machine-local lock file.
.kiro/settings/.kirocrew-cli-settings.lock

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env

# Large raw data (keep cleaned CSVs, ignore bulky raw pulls)
data/raw/*
!data/raw/.gitkeep

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
